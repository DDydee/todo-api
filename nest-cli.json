{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "src/.config/**/*",
        "outDir": "./dist/.config",
        "watchAssets": true
      }
    ],
    "watchAssets": true,
    "builder": "swc",
    "typeCheck": true,
    "deleteOutDir": true
  }
}
